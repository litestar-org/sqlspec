{#- Render class attributes as a 3-column Attributes table even when members: false hides method children. -#}
{% if not obj.docstring.parsed | selectattr("kind.value", "eq", "attributes") | list %}
  {% with summary_members_list = None if config.members is sameas false else members_list %}
    {% with section = obj.attributes
        |filter_objects(
          filters=config.filters,
          members_list=summary_members_list,
          inherited_members=config.inherited_members,
          keep_no_docstrings=config.show_if_no_docstring,
        )
        |order_members(config.members_order, summary_members_list)
        |as_attributes_section(check_public=not summary_members_list)
      %}
      {% if section %}{% include "docstring/attributes.html.jinja" with context %}{% endif %}
    {% endwith %}
  {% endwith %}
{% endif %}
